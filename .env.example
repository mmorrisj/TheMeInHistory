# Required. The narrator, auditor, and synthesist all call the Claude API.
ANTHROPIC_API_KEY=

# Optional overrides. Defaults are set in src/llm/client.ts.
# NARRATOR_MODEL=claude-opus-5
# AUDITOR_MODEL=claude-haiku-4-5
# SYNTHESIST_MODEL=claude-opus-5

# Where play sessions are persisted by the file-backed session store.
# SESSION_DIR=.sessions
